.DS_Store
*.out

vendor/

*.swp
build/
dist/

# Stray mockserver binary built at repo root (source lives in e2e/mockserver/).
# Anchored to root so the e2e/mockserver/ source directory is not ignored.
/mockserver

.build-ready

# Local reference checkout of Maestro for driver parity work (not committed).
.maestro-ref/

# Agent-managed git worktrees. These are nested checkouts of this same
# repository, so `git add -A` would otherwise stage them as embedded repos.
.claude/worktrees/

# Gradle's per-project caches. The wrapper, the keystore and the built
# APKs under drivers/android/prebuilt/ ARE committed; this is only the
# local build state.
.gradle/
local.properties
