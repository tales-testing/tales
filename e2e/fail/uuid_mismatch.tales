version = 1

config {
  base_url = env("BASE_URL", "http://localhost:1337")
}

scenario "uuid matcher rejects a non-UUID value" {
  tags = ["matchers", "uuid", "failure"]

  step "http" "echo_bad_uuid" {
    request {
      method = "POST"
      url    = "${config.base_url}/echo"

      headers = {
        Content-Type = "application/json"
      }

      body {
        json = {
          id = "not-a-uuid"
        }
      }
    }

    expect {
      status = 200

      json = {
        id = uuid("v4")
      }
    }
  }
}
