version = 1

config {
  mobile = {
    targets = {
      phone = {
        platform    = "android"
        device_name = env("ANDROID_AVD_NAME", "tales-e2e")
        serial      = env("ANDROID_SERIAL", "")
        app         = env("ANDROID_APP_PATH")
        app_id      = env("ANDROID_APP_ID", "org.taleslabs.tales.demo")
      }
    }
  }
}

scenario "Android scroll_to reaches elements in both directions" {
  tags = ["android", "mobile", "demo", "scroll"]

  skip_unless {
    env_set = ["ANDROID_APP_PATH"]
    reason  = "Android tests need ANDROID_APP_PATH pointing at the demo APK and a running device"
  }

  step "mobile" "android_open_gestures" {
    platform = "android"
    target   = "phone"

    launch {
      clear_state = true
    }

    actions {
      wait_visible {
        id      = "welcome.gestures"
        timeout = "30s"
      }
      tap {
        id = "welcome.gestures"
      }
      wait_visible {
        id      = "gestures.screen"
        timeout = "10s"
      }
    }
  }

  # Forward: the last row of a lazy list is genuinely absent from the
  # tree until scrolling composes it, so this only passes if scroll_to
  # actually moved the container rather than reporting a stale hit.
  step "mobile" "android_scroll_to_last_row" {
    depends_on = ["android_open_gestures"]

    platform = "android"
    target   = "phone"

    actions {
      scroll_to {
        id = "gestures.row.23"
      }
    }

    expect {
      visible {
        id = "gestures.row.23"
      }
    }
  }

  # Backward, and the regression this suite exists for. The list is now
  # parked at its end, so the first row is both off-screen and disposed.
  # A forward-only scroll_to could never reach it: every attempt moved
  # further away, the container refused to travel, and the handler
  # answered 404 "element not found" for an element that was simply
  # above the viewport.
  step "mobile" "android_scroll_back_to_first_row" {
    depends_on = ["android_scroll_to_last_row"]

    platform = "android"
    target   = "phone"

    actions {
      scroll_to {
        id = "gestures.row.0"
      }
    }

    expect {
      visible {
        id = "gestures.row.0"
      }
    }
  }

  # Idempotent: calling it on something already on screen is a no-op,
  # which is what lets a scenario scroll defensively before every
  # interaction without first querying UI state.
  step "mobile" "android_scroll_to_visible_is_a_noop" {
    depends_on = ["android_scroll_back_to_first_row"]

    platform = "android"
    target   = "phone"

    actions {
      scroll_to {
        id = "gestures.status.longpress"
      }
      scroll_to {
        id = "gestures.status.longpress"
      }
    }

    expect {
      text {
        id    = "gestures.status.longpress"
        value = "longpress=0"
      }
    }
  }

  # Best-effort on a screen with nothing to scroll. This is the shape the
  # Android port tripped on: a Compose container only publishes itself as
  # scrollable once its content overflows, so on a screen that fits there
  # is no container at all. scroll_to must treat that as "already where
  # it needs to be", not as a missing element, or the same scenario
  # passes or fails depending on the AVD's screen size.
  step "mobile" "android_scroll_to_without_a_scrollable" {
    depends_on = ["android_scroll_to_visible_is_a_noop"]

    platform = "android"
    target   = "phone"

    actions {
      press_button {
        button = "back"
      }
      wait_visible {
        id      = "welcome.backnav"
        timeout = "10s"
      }
      tap {
        id = "welcome.backnav"
      }
      wait_visible {
        id      = "backnav.screen"
        timeout = "10s"
      }
      scroll_to {
        id = "backnav.leave"
      }
    }

    expect {
      visible {
        id = "backnav.leave"
      }
    }
  }

  # The label locator resolves the same way, so scroll_to reaches an
  # element that exposes only an accessibility label.
  step "mobile" "android_scroll_to_by_text" {
    depends_on = ["android_scroll_to_without_a_scrollable"]

    platform = "android"
    target   = "phone"

    actions {
      scroll_to {
        text = "Press the back button to leave"
      }
    }

    expect {
      visible {
        id = "backnav.title"
      }
    }
  }

  # Regression for issue #64: scroll_to used to dispatch once and fail
  # the moment the element was absent, so a screen still being built
  # made it a race. The scenario shape that reads as tolerant put the
  # wait *after* the scroll, where it never ran, and the failure landed
  # on the step that looks best-effort. Signing in shows the feed 400ms
  # later, so this scroll_to starts before its screen exists.
  step "mobile" "android_scroll_to_on_a_loading_screen" {
    depends_on = ["android_scroll_to_by_text"]

    platform = "android"
    target   = "phone"

    launch {
      clear_state = true
    }

    actions {
      wait_visible {
        id      = "welcome.signin"
        timeout = "30s"
      }
      tap {
        id = "welcome.signin"
      }
      wait_visible {
        id      = "login.screen"
        timeout = "10s"
      }
      input_text {
        id    = "login.email"
        value = "user@example.com"
      }
      input_text {
        id     = "login.password"
        value  = "Secret123!"
        secure = true
      }
      tap {
        id = "login.submit"
      }
      # No wait in between, on purpose: this is the ordering the issue
      # reported, and it must now work rather than merely be unlucky.
      scroll_to {
        id      = "feed.item.20"
        timeout = "20s"
      }
      wait_visible {
        id      = "feed.item.20"
        timeout = "10s"
      }
    }
  }

  # Regression for issue #69: the driver answered 404 for an element it
  # had just scrolled into view. Its loop skipped the settle + cache
  # invalidation when a container reported it could not travel further,
  # so the closing lookup read the tree from before the scroll that
  # revealed the element. The detail screen below is that shape: a plain
  # verticalScroll column whose Delete button is the last child, so the
  # scroll that brings it on screen is exactly the one that hits the end
  # of the range.
  step "mobile" "android_scroll_to_the_end_of_a_column" {
    depends_on = ["android_scroll_to_on_a_loading_screen"]

    platform = "android"
    target   = "phone"

    actions {
      # The previous step left the feed scrolled to this row.
      wait_visible {
        id      = "feed.item.20"
        timeout = "10s"
      }
      tap {
        id = "feed.item.20"
      }
      wait_visible {
        id      = "feed.detail.screen"
        timeout = "10s"
      }
      scroll_to {
        id = "feed.detail.delete"
      }
    }

    # The scroll itself is what this step proves, so it asserts on the
    # element being on screen rather than on a follow-up tap, which a
    # still-settling scroll container can swallow.
    expect {
      visible {
        id = "feed.detail.delete"
      }
    }
  }

  teardown {
    step "mobile" "android_terminate" {
      when = true

      platform = "android"
      target   = "phone"
      terminate {}
    }
  }
}
