version = 1

# Canonical mail (SMTP/LMTP) ingestion scenario for Tales V1.
#
# - The mail provider INJECTS a message; it never reads a mailbox.
# - Always capture response.json.message_id and then assert the
#   application's downstream behaviour through HTTP / SQL / UI. The mail
#   step alone only proves the server accepted the bytes.
# - Targets are pulled from config.mail.targets.<name>. SMTP supports
#   tls / starttls / AUTH PLAIN; LMTP runs over tcp or a unix socket.

config {
  base_url = env("BASE_URL", "http://localhost:1337")

  mail = {
    targets = {
      smtp_inbound = {
        protocol = "smtp"
        host     = "127.0.0.1"
        port     = 12525
        tls      = false
      }

      lmtp_inbound = {
        protocol = "lmtp"
        network  = "tcp"
        address  = "127.0.0.1:2424"
      }
    }
  }
}

scenario "SMTP email ingestion" {
  tags = ["mail", "smtp"]

  step "mail" "send_email" {
    target = "smtp_inbound"

    message {
      from    = "sender@example.com"
      to      = ["archive@example.test"]
      subject = "SMTP ingestion test"
      text    = "Hello from Tales SMTP"

      headers = {
        "X-Test-ID" = "smtp-001"
      }

      # Optional inline attachment (exactly one of content / path):
      attachment {
        filename     = "proof.json"
        content_type = "application/json"
        content      = jsonencode({ proof_id = "p-123" })
      }
    }

    expect {
      json = {
        accepted = true
        recipients = {
          rejected = []
        }
      }
    }

    capture {
      message_id = response.json.message_id
    }
  }

  # IMPORTANT: verify the application actually processed the message.
  # Here the e2e mock server exposes received mail at
  # GET /mail/messages?id=<message-id>; a real app would expose the
  # parsed result (a case, a ticket, a row) instead. url_encode the id
  # because it contains angle brackets and an @.
  step "http" "assert_received" {
    request {
      method = "GET"
      url    = "${config.base_url}/mail/messages?id=${url_encode(result.send_email.message_id)}"
    }

    expect {
      status = 200

      json = {
        subject = "SMTP ingestion test"
        from    = "sender@example.com"
      }
    }
  }
}
