version = 1

config {
  mobile = {
    targets = {
      iphone = {
        platform    = "ios"
        device_name = env("IOS_DEVICE_NAME", "iPhone 17")
        app         = env("IOS_APP_PATH")
        bundle_id   = env("IOS_BUNDLE_ID", "com.example.MyApp")
        driver = {
          host = env("IOS_DRIVER_HOST", "127.0.0.1")
          # port is optional in embedded mode; omit to auto-allocate a free port
        }
      }
    }
  }
}

generator "email" "user_email" {
  prefix = "ios-"
  domain = "example.com"
}

generator "password" "user_password" {
  length      = 16
  min_upper   = 1
  min_lower   = 1
  min_digit   = 1
  min_special = 1
}

scenario "iOS register happy path" {
  tags = ["ios", "mobile", "smoke"]

  step "mobile" "launch" {
    platform = "ios"
    target   = "iphone"
    launch {
      # clear_state reinstalls the app and resets the simulator
      # Keychain, so credentials never leak between scenarios.
      clear_state = true
    }
    expect {
      visible {
        id      = "welcome.register"
        timeout = "20s"
      }
      text {
        id    = "welcome.title"
        value = "MyApp"
      }
    }
  }

  step "mobile" "open_register" {
    platform = "ios"
    target   = "iphone"
    actions {
      tap { id = "welcome.register" }
      wait_visible { id = "register.screen" }
    }
    expect {
      visible  { id = "register.screen" }
      disabled { id = "register.submit" }
    }
  }

  step "mobile" "submit_register" {
    platform = "ios"
    target   = "iphone"
    actions {
      input_text {
        id    = "register.email"
        value = generate("user_email")
      }
      input_text {
        id     = "register.password"
        value  = generate("user_password")
        secure = true
      }
      tap { id = "register.submit" }
      wait_not_visible {
        id      = "register.loading"
        timeout = "5s"
      }
      wait_visible {
        id      = "home.screen"
        timeout = "10s"
      }
    }
    expect {
      enabled { id = "home.logout" }
      value {
        id    = "register.email"
        value = contains("@example.com")
      }
      text {
        id    = "home.title"
        value = "Welcome"
      }
    }
    capture {
      email = value("register.email")
    }
  }

  teardown {
    step "mobile" "terminate" {
      when = true

      platform = "ios"
      target   = "iphone"
      terminate {}
    }
  }
}

# System-picker pattern: every cell of an iOS PhotosPicker / file
# importer shares the same accessibility identifier as a sibling, so the
# strict resolver fails with `multiple elements share the same id`.
# Opt every element-targeted action into pre-order first-match with
# `first = true` to interact with the first cell. Do NOT use `first` in
# `expect` blocks — assertions keep the uniqueness guarantee on purpose.
scenario "iOS PhotosPicker first cell" {
  step "mobile" "pick_first_photo" {
    platform = "ios"
    target   = "iphone"
    actions {
      wait_visible {
        id      = "PXGGridLayout-Info"
        first   = true
        timeout = "15s"
      }
      tap {
        id    = "PXGGridLayout-Info"
        first = true
      }
    }
  }
}

# System controller buttons (PhotosPicker / PHPickerViewController Done,
# document picker, share sheet, mail composer, ...) carry an
# accessibilityLabel but no accessibilityIdentifier. The `label = "..."`
# locator is the only way to reach them. Mutually exclusive with `id`;
# accepted on every action AND every expect block.
scenario "iOS PhotosPicker Done button" {
  step "mobile" "confirm_photo_pick" {
    platform = "ios"
    target   = "iphone"
    actions {
      wait_visible {
        label   = "Done"
        timeout = "10s"
      }
      tap {
        label = "Done"
      }
    }
    expect {
      visible { label = "Done" }
    }
  }
}
